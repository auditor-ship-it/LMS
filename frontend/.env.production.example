# Baked into the bundle at BUILD time, not read at runtime.
# Without it the build falls back to http://localhost:4001/api (see
# src/shared/auth/client.js), which in a user's browser points at THEIR
# machine — every API call fails. scripts/deploy.sh refuses to build if
# neither this file nor VITE_API_URL is present.
#
# On the VPS: cp frontend/.env.production.example frontend/.env.production
VITE_API_URL=https://lease.crystalgrp.xyz/api
