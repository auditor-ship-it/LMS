# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit real credentials (Google service account key,
# Mongo connection string). Applies at every depth (.env, backend/.env,
# frontend/.env, ...).
.env
.env.*
!.env.example

# Raw Google service account key JSON downloads (e.g. project-id-hash.json) —
# fields get copied into .env; the file itself must never be committed.
*-*.iam.gserviceaccount.com.json
nikunj-*.json
*-service-account*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Persisted FMS sheet snapshots (backend/src/services/stage8.service.js) - regenerated, never committed
backend/.cache/
